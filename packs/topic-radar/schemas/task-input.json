            "required": [
              "type"
            ]
          }
        },
        "scores": {
          "type": "object",
          "additionalProperties": true
        },
        "video_fit": {
          "type": "string"
        }
      },
      "required": [
        "title",
        "introduction",
        "source_summary",
        "source_refs",
        "scores",
        "video_fit"
      ]
