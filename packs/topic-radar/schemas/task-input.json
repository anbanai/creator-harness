    "source_records": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "type": {
            "type": "string"
          },
          "label": {
            "type": "string"
          },
          "platform": {
            "type": "string"
          },
          "ref_id": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "url": {
            "type": "string"
          },
          "rank": {
            "type": "integer",
            "minimum": 0
          },
          "hot": {
            "type": "number"
          },
          "fetched_at": {
            "type": "string",
            "format": "date-time"
          },
          "freshness": {
            "type": "string"
          }
        },
        "required": [
          "type"
        ]
      }
