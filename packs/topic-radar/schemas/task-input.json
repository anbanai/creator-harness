{
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "type": "string",
      "enum": [
        "1.0"
      ]
    },
    "task_id": {
      "type": "string"
    },
    "execution_id": {
      "type": "string"
    },
    "task_kind": {
      "type": "string",
      "enum": [
        "topic_digest",
        "topic_script"
      ]
    },
    "snapshot": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "snapshot_id": {
          "type": "string"
        },
        "snapshot_hash": {
          "type": "string"
        },
        "captured_at": {
          "type": "string",
          "format": "date-time"
        },
        "project_id": {
          "type": "string"
        },
        "subscription_id": {
          "type": "string"
        },
        "digest_id": {
          "type": "string"
        },
        "suggestion_id": {
          "type": "string"
        }
      },
