    "target": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "platform": {
          "type": "string"
        },
        "duration_seconds": {
          "type": "integer",
          "minimum": 1
        },
        "aspect_ratio": {
          "type": "string"
        }
      }
    },
    "candidates": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "title": {
            "type": "string"
          },
          "introduction": {
            "type": "string"
          },
          "source_summary": {
            "type": "string"
          },
          "source_refs": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "type": {
                  "type": "string"
                },
                "label": {
                  "type": "string"
                },
                "platform": {
                  "type": "string"
                },
                "ref_id": {
                  "type": "string"
                },
                "title": {
                  "type": "string"
                },
                "url": {
                  "type": "string"
                },
                "rank": {
                  "type": "integer",
                  "minimum": 0
                },
                "hot": {
                  "type": "number"
                },
                "fetched_at": {
                  "type": "string",
                  "format": "date-time"
                },
                "freshness": {
                  "type": "string"
