{
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "type": "string",
      "enum": [
        "1.0"
      ]
    },
    "task_kind": {
      "type": "string",
      "enum": [
        "content_research",
        "content_validation",
        "content_script"
      ]
    },
    "candidates": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "asset_id": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "summary": {
            "type": "string"
          },
          "source_refs": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "required": [
          "title"
        ]
      }
    },
    "accepted_artifacts": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "task_id": {
            "type": "string"
          },
          "execution_id": {
            "type": "string"
          },
          "path": {
            "type": "string"
          },
          "content_sha256": {
            "type": "string"
          }
        },
        "required": [
          "task_id",
          "execution_id",
          "path",
          "content_sha256"
        ]
      }
    },
    "target_requirements": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "platform": {
          "type": "string",
          "enum": [
            "wechat",
            "seednote",
            "moments",
            "ecommerce",
            "montage",
            "whiteboard-animation",
            "hypit"
          ]
        },
        "duration_seconds": {
          "type": "number",
          "minimum": 1,
          "maximum": 3600
        },
        "aspect_ratio": {
          "type": "string",
          "enum": [
            "9:16",
            "16:9",
            "1:1",
            "3:4",
            "4:3"
          ]
        }
      },
      "required": [
        "platform"
      ]
    },
    "internal_sources": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "project_id": {
            "type": "string"
          },
          "content_id": {
            "type": "string"
          },
          "analytics_revision": {
            "type": "integer",
            "minimum": 1
          }
        },
        "required": [
          "project_id",
          "content_id",
          "analytics_revision"
        ]
      }
    }
  },
  "required": [
    "schema_version",
    "task_kind",
    "candidates",
    "accepted_artifacts"
  ]
}
