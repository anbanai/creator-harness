{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "project_id",
    "platform",
    "agent_ids",
    "profile_url",
    "platform_accounts",
    "profile_setup",
    "answers",
    "samples",
    "current_profile",
    "expected_revision"
  ],
  "additionalProperties": false,
  "properties": {
    "project_id": {
      "type": "string"
    },
    "platform": {
      "type": "string",
      "description": "Legacy primary context. The selected creation Agents are authoritative in agent_ids."
    },
    "agent_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "wechat-article",
          "wechat-picture",
          "seednote",
          "montage",
          "hypit",
          "whiteboard-animation"
        ]
      }
    },
    "profile_url": {
      "type": "string",
      "description": "Legacy primary homepage URL; prefer platform_accounts."
    },
    "platform_accounts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "platform",
          "profile_url",
          "source"
        ],
        "additionalProperties": false,
        "properties": {
          "platform": {
            "type": "string",
            "enum": [
              "wechat",
              "seednote",
              "douyin",
              "bilibili",
              "weibo",
              "zhihu",
              "kuaishou",
              "channels"
            ]
          },
          "account_name": {
            "type": "string"
          },
          "profile_url": {
            "type": "string"
          },
          "follower_range": {
            "type": "string"
          },
          "source": {
            "type": "string",
            "enum": [
              "[用户确认]",
              "[用户编辑]",
              "[链接分析]",
              "[推断待确认]",
              "[待补充]"
            ]
          }
        }
      }
    },
